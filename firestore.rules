rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function approved() { return signedIn() && myProfile().status == "approved"; }
    function admin() { return approved() && myProfile().role == "admin"; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == "user"
        && request.resource.data.status == "pending";
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow update, delete: if admin();
    }
    match /transactions/{id} {
      allow read, create: if approved();
      allow update: if admin();
      allow delete: if admin();
    }
    match /deleteRequests/{id} {
      allow create: if approved()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == "pending";
      allow read: if admin() || (approved() && resource.data.requestedBy == request.auth.uid);
      allow update, delete: if admin();
    }
  }
}